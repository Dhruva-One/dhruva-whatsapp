{
  "name": "dhruva-whatsapp",
  "private": true,
  "version": "0.1.0",
  "description": "DhruvaOne WhatsApp gateway: queue-first webhook receiver, conversation state, templates, intake, handover",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "simulate": "tsx scripts/simulate-inbound.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "bullmq": "^5.81.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
